# Prover Network requester private key, or AWS KMS key ARN when USE_KMS_REQUESTER=true.
NETWORK_PRIVATE_KEY=

# Proof fulfillment strategy: auction or reserved.
SP1_HELIOS_FULFILLMENT_STRATEGY=auction

# On-chain proof mode: plonk or groth16 (the configured SP1 verifier must accept it).
SP1_HELIOS_PROOF_MODE=plonk

# Set true when NETWORK_PRIVATE_KEY is an AWS KMS key ARN.
USE_KMS_REQUESTER=false
